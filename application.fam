App(
    appid="flipper_uni_remote",
    name="Uni Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="uni_remote_app",
    stack_size=8 * 1024,
    fap_category="Infrared",
    fap_description="Universal remote with IR, stateful AC and Bluetooth HID",
    fap_version="0.10",
    fap_author="congnvp",
    fap_weburl="https://github.com/congnvp/Flipper-Uni-Remote",
    sources=["src/*.c"],
    fap_libs=["infrared", "ble_profile"],
)
