App(
    appid="flipper_uni_remote",
    name="Uni Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="uni_remote_app",
    stack_size=6 * 1024,
    fap_category="Infrared",
    fap_description="Data-driven universal remote for IR and future BLE profiles",
    fap_version="0.3",
    fap_author="congnvp",
    fap_weburl="https://github.com/congnvp/Flipper-Uni-Remote",
    sources=["src/*.c"],
    fap_libs=["infrared"],
)
